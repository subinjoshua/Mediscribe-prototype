  {
    "PK": "ENCOUNTER#E001",
    "SK": "NOTE#2026-03-01T20:00:00Z",
    "encounterId": "E001",
    "date": "2026-03-01",
    "day": 1,
    "author": "Dr. Priya Sharma",
    "note": "Emergency presentation with acute substernal chest pain radiating to left arm. Started on DAPT (aspirin + clopidogrel), heparin infusion, and nitroglycerin. ECG showed ST depression in leads V3-V6. Troponin I elevated at 8.2 ng/mL. Cardiology consult requested. Patient hemodynamically stable on monitoring."
  },
  {
    "PK": "ENCOUNTER#E001",
    "SK": "NOTE#2026-03-02T18:00:00Z",
    "encounterId": "E001",
    "date": "2026-03-02",
    "day": 2,
    "author": "Dr. Priya Sharma",
    "note": "Taken for coronary angiography which revealed 90% stenosis of LAD artery. Underwent PCI with drug-eluting stent (DES) placement to LAD. Post-procedure hemodynamically stable. Troponin trending down to 5.8 ng/mL. Continued on DAPT and heparin. No chest pain post-procedure."
  },
  {
    "PK": "ENCOUNTER#E001",
    "SK": "NOTE#2026-03-03T18:00:00Z",
    "encounterId": "E001",
    "date": "2026-03-03",
    "day": 3,
    "author": "Dr. Priya Sharma",
    "note": "Post-PCI Day 1. Hemodynamically stable. Chest pain free. Troponin trending down to 3.1 ng/mL. Started on high-intensity statin (Atorvastatin 40mg). Adjusted diabetes medications — continued Metformin 500mg BD. Heparin discontinued. Patient tolerating oral diet well."
  },
  {
    "PK": "ENCOUNTER#E001",
    "SK": "NOTE#2026-03-04T18:00:00Z",
    "encounterId": "E001",
    "date": "2026-03-04",
    "day": 4,
    "author": "Dr. Priya Sharma",
    "note": "Mobilized to bedside and corridor. Tolerating oral diet. Troponin 1.2 ng/mL. BP well controlled on Ramipril 5mg + Metoprolol 25mg BD. Echocardiogram performed showing mild LV dysfunction with ejection fraction (EF) 45%. No pericardial effusion. Plan to continue current medications and monitor."
  },
  {
    "PK": "ENCOUNTER#E001",
    "SK": "NOTE#2026-03-05T18:00:00Z",
    "encounterId": "E001",
    "date": "2026-03-05",
    "day": 5,
    "author": "Dr. Priya Sharma",
    "note": "Fit for discharge. Cardiac rehabilitation discussed with patient and family. Discharge medications reviewed and explained. Follow-up appointments arranged: Cardiology in 2 weeks, Diabetology in 1 month. Patient educated on warning signs requiring emergency presentation. Dietary and lifestyle modifications counseled."
  },

